{
  "realm": "donatrack",
  "enabled": true,
  "displayName": "DonaTrack Solidario",
  "sslRequired": "none",
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "roles": {
    "realm": [
      {
        "name": "ROLE_ADMIN",
        "description": "Administrador del Sistema DonaTrack"
      },
      {
        "name": "ROLE_DONANTE",
        "description": "Donante particular o corporativo"
      },
      {
        "name": "ROLE_BENEFICIARIA",
        "description": "Entidad receptora o comedor comunitario"
      },
      {
        "name": "ROLE_CHOFER",
        "description": "Operador de logística y chofer de flota"
      }
    ]
  },
  "clients": [
    {
      "clientId": "donatrack-client",
      "name": "DonaTrack Web & Gateway",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "redirectUris": [
        "http://localhost:8080/*",
        "http://localhost:8086/*",
        "http://localhost:3000/*"
      ],
      "webOrigins": [
        "*"
      ],
      "defaultClientScopes": [
        "web-origins",
        "roles",
        "profile",
        "email"
      ]
    }
  ],
