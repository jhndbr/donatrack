@startuml
skinparam componentStyle uml2
skinparam roundcorner 8
skinparam monochrome false
skinparam packageStyle rectangle

title Arquitectura Física y Lógica de Microservicios - DonaTrack (DDSI 2026)

actor "Usuario Web / Donante" as WebUser
actor "Entidad Beneficiaria" as BeneficiariaUser
actor "Chofer / Transportista" as ChoferUser
actor "Administrador Cátedra" as AdminUser

package "Capa Perimetral y Seguridad" {
    [API Gateway\n(Spring Cloud Gateway :8080)] as Gateway
    [Keycloak Identity Provider\n(OIDC / OAuth2 / JWT :8081)] as Keycloak
}

package "Ecosistema de Microservicios (Spring Boot 3.2)" {
    component "donaciones-service (:8082)" as DonacionesSvc {
        [API REST Donaciones] as API_Don
        [Motor Matchmaking (Strategy)] as Engine_Match
        [Streaming CSV Importer] as CSV_Stream
        [Transactional Outbox Scheduler] as Outbox_Pub
    }

    component "logistica-service (:8083)" as LogisticaSvc {
        [API REST Logística & Flotas] as API_Log
        [Agrupador de Lotes (<= 100)] as Batch_Router
        [Webhook Callback Listener] as Webhook_Log
        [Telemetría GPS Tracker] as GPS_Tracker
    }

    component "incentivos-service (:8084)" as IncentivosSvc {
        [API REST Gamificación] as API_Inc
        [Motor de Misiones e Insignias] as Engine_Gamif
        [Cron Ranking Mensual (0 0 0 1 * ?)] as Cron_Ranking
    }

    component "notificaciones-service (:8085)" as NotificacionesSvc {
        [AMQP Consumer (RabbitListener)] as AMQP_Sub
        [Despachador Multi-Canal] as Dispatcher
    }
}

package "Broker de Mensajería Asíncrona" {
    queue "Topic Exchange: donatrack.events\n(RabbitMQ AMQP :5672 / UI :15672)" as RabbitMQ
    queue "q.notificaciones.donaciones" as Q_Notif_Don
    queue "q.notificaciones.logistica" as Q_Notif_Log
    queue "q.notificaciones.incentivos" as Q_Notif_Inc
    queue "q.incentivos.donaciones" as Q_Inc_Don
}

package "Persistencia Políglota" {
    database "PostgreSQL 16 (Relacional)\ndonaciones_db (:5432)" as DB_Donaciones
    database "MongoDB 7.0 (NoSQL Documental)\nlogistica_db (:27017)" as DB_Logistica
    database "PostgreSQL 16 (Relacional)\nincentivos_db (:5432)" as DB_Incentivos
    database "PostgreSQL 16\nkeycloak_db (:5432)" as DB_Keycloak
}

package "Servicios Externos y Automatización" {
    [Mailpit SMTP Server (:1025 / UI :8025)] as Mailpit
    [n8n Workflow Automation\n(Difusión en Redes Sociales)] as N8N
    [Optimizador Externo de Rutas\n(Algoritmo VRP / Lotes <= 100)] as RoutePlanner
}

' Flujos de acceso de usuarios
WebUser --> Gateway : HTTPS / JWT Bearer
BeneficiariaUser --> Gateway : HTTPS / JWT Bearer
ChoferUser --> Gateway : HTTPS / Telemetría GPS
AdminUser --> Gateway : HTTPS / Administracion

' Seguridad y Validación
Gateway .right.> Keycloak : 1. Valida Tokens JWT (JWKS / Introspect)
Keycloak --> DB_Keycloak : Persiste Realms / Usuarios

' Enrutamiento Inverso desde Gateway
Gateway --> API_Don : /api/v1/donaciones/**
Gateway --> API_Log : /api/v1/logistica/**
Gateway --> API_Inc : /api/v1/incentivos/**

' Persistencia por Servicio
DonacionesSvc --> DB_Donaciones : JPA / Hibernate Batch
IncentivosSvc --> DB_Incentivos : JPA / Hibernate
LogisticaSvc --> DB_Logistica : Spring Data MongoDB (GeoSpatial 2dsphere)

' Integración Inter-Servicios Sincrónica
LogisticaSvc ..> API_Don : REST Sincrónico\n(Consultar donaciones ASIGNACION_REALIZADA\nActualizar estados a EN_TRASLADO / ENTREGADA)

' Planificación de Rutas Externa
Batch_Router --> RoutePlanner : POST /optimizar (Lotes <= 100 elementos)
RoutePlanner --> Webhook_Log : POST /api/v1/logistica/rutas/callback (JSON)

' Mensajería Asíncrona (RabbitMQ)
Outbox_Pub --> RabbitMQ : Publica donacion.asignada, donante.inactivo
LogisticaSvc --> RabbitMQ : Publica ruta.iniciada, entrega.confirmada, entrega.fallida
IncentivosSvc --> RabbitMQ : Publica mision.cumplida, categoria.ascendida

' Enrutamiento interno de RabbitMQ
RabbitMQ --> Q_Notif_Don : binding: donacion.*
RabbitMQ --> Q_Notif_Log : binding: ruta.*, entrega.*
RabbitMQ --> Q_Notif_Inc : binding: mision.*, categoria.*
RabbitMQ --> Q_Inc_Don : binding: donacion.asignada

' Consumo Asíncrono
AMQP_Sub <-- Q_Notif_Don : Mensajes AMQP
AMQP_Sub <-- Q_Notif_Log : Mensajes AMQP
AMQP_Sub <-- Q_Notif_Inc : Mensajes AMQP
API_Inc <-- Q_Inc_Don : Suma Puntos Donante

' Salidas hacia el exterior
Dispatcher --> Mailpit : Correo SMTP (:1025)
Engine_Gamif ..> N8N : Webhook POST (Difusión Insignias / Logros)

@enduml
