@startuml
skinparam classAttributeIconSize 0
skinparam monochrome false
skinparam roundcorner 8
skinparam shadowing false
skinparam packageStyle rectangle

title Modelo Integral de Dominio y Eventos - DonaTrack (DDSI 2026)

' ========================================================
' PAQUETE COMÚN: CONTRATOS Y ENUMS
' ========================================================
package "common-dtos (Contratos de Eventos y Enums)" #F0F0F0 {

    enum EstadoDonacion {
        EN_DEPOSITO
        ASIGNACION_REALIZADA
        LISTA_PARA_ENTREGAR
        EN_TRASLADO
        ENTREGADA
        ENTREGA_FALLIDA
        VENCIDA
    }

    enum TipoNecesidad {
        EXTRAORDINARIA
        RECURRENTE
    }

    enum CanalNotificacion {
        EMAIL
        SMS
        WHATSAPP
    }

    enum CategoriaDonante {
        COLABORADOR
        SOSTENEDOR
        TRANSFORMADOR
    }

    class DonacionRegistradaEvent <<Event>> {
        + idDonacion: Long
        + idDonante: Long
        + nombreDonante: String
        + emailDonante: String
        + canalPreferidoDonante: String
        + contactoPreferidoDonante: String
        + subcategoria: String
        + cantidad: double
        + fechaRegistro: LocalDateTime
    }

    class DonacionAsignadaEvent <<Event>> {
        + idDonacion: Long
        + idDonante: Long
        + emailDonante: String
        + canalPreferido: CanalNotificacion
        + contactoPreferido: String
        + idEntidadBeneficiaria: Long
        + nombreEntidad: String
        + emailEntidad: String
        + subcategoria: String
        + cantidad: double
        + fechaAsignacion: LocalDateTime
    }

    class EntregaConfirmadaEvent <<Event>> {
        + idEntrega: String
        + idRuta: String
        + idDonacion: Long
        + idEntidadBeneficiaria: Long
        + nombreEntidad: String
        + emailEntidad: String
        + idDonante: Long
        + emailDonante: String
        + canalPreferidoDonante: String
        + contactoPreferidoDonante: String
        + patenteCamion: String
        + fotosUrls: List<String>
        + fechaConfirmacion: LocalDateTime
    }

    class EntregaFallidaEvent <<Event>> {
        + idEntrega: String
        + idRuta: String
        + idDonacion: Long
        + idEntidadBeneficiaria: Long
        + nombreEntidad: String
        + idDonante: Long
        + emailDonante: String
        + canalPreferidoDonante: String
        + contactoPreferidoDonante: String
        + motivoFalla: String
        + replanificable: boolean
        + fechaFalla: LocalDateTime
    }

    class MisionCumplidaEvent <<Event>> {
        + idDonante: Long
        + emailDonante: String
        + canalPreferido: String
        + contactoPreferido: String
        + idMision: Long
        + nombreMision: String
        + nombreInsignia: String
        + fechaCumplimiento: LocalDateTime
    }
}

' ========================================================
' SERVICIO DE DONACIONES (PostgreSQL)
' ========================================================
package "donaciones-service (PostgreSQL)" #EEF4FF {

    abstract class PersonaDonante {
        - id: Long
        - fechaRegistro: LocalDateTime
        - ultimaActividad: LocalDateTime
        - ultimaAlertaInactividad: LocalDateTime
        - activo: boolean
        - fechaBaja: LocalDateTime
        - motivoBaja: String
        + {abstract} getNombreCompleto(): String
        + {abstract} getIdentificadorPrincipal(): String
        + {abstract} getEmailPrincipal(): String
        + registrarActividad(): void
        + darDeBaja(motivo: String): void
        + agregarMedioContacto(m: MedioContacto): void
        + getMedioContactoPredeterminado(): MedioContacto
    }

    class PersonaHumana {
        - nombre: String
        - apellido: String
        - edad: Integer
        - tipoDocumento: String
        - nroDocumento: String
        - genero: String
        - direccion: String
        - latitud: Double
        - longitud: Double
    }

    class PersonaJuridica {
        - razonSocial: String
        - cuit: String
        - tipo: String
        - rubro: String
        - direccion: String
        - latitud: Double
        - longitud: Double
        - representantes: List<String>
        + agregarRepresentante(rep: String): void
    }

    class MedioContacto {
        - id: Long
        - tipo: CanalNotificacion
        - valor: String
        - esPredeterminado: boolean
    }

    class EntidadBeneficiaria {
        - id: Long
        - razonSocial: String
        - direccion: String
        - latitud: Double
        - longitud: Double
        - telefono: String
        - emailsRepresentantes: List<String>
        - donacionesRecibidasTrimestre: int
        - activo: boolean
        + agregarNecesidad(n: NecesidadMaterial): void
        + registrarDonacionRecibida(): void
    }

    class NecesidadMaterial {
        - id: Long
        - subcategoria: String
        - descripcion: String
        - tipo: TipoNecesidad
        - cantidadSolicitada: double
        - cantidadCubierta: double
        - unidadMedida: String
        - periodo: String
        - activa: boolean
        + estaSatisfecha(): boolean
        + registrarCobertura(cant: double): void
        + revertirCobertura(cant: double): void
    }

    class Donacion {
        - id: Long
        - version: Long
        - subcategoria: String
        - cantidad: double
        - unidadMedida: String
        - esUsado: boolean
        - fechaVencimiento: LocalDate
        - fechaRecepcion: LocalDateTime
        - fechaActualizacionEstado: LocalDateTime
        - estado: EstadoDonacion
        - justificacionFalla: String
        + asignarA(e: EntidadBeneficiaria, n: NecesidadMaterial, resp: String): void
        + desasignar(motivo: String, resp: String): void
        + marcarListaParaEntregar(resp: String): void
        + iniciarTraslado(resp: String): void
        + confirmarEntrega(resp: String): void
        + registrarEntregaFallida(justificacion: String, resp: String): void
        + reingresarADeposito(resp: String): void
        + marcarVencida(resp: String): void
    }

    class BienDonado {
        - id: Long
        - descripcion: String
        - categoria: String
        - subcategoria: String
        - cantidad: double
        - unidadMedida: String
        - esUsado: boolean
        - fechaVencimiento: LocalDate
        - fotoUrl: String
    }

    class HistorialEstadoDonacion {
        - id: Long
        - fechaHora: LocalDateTime
        - estadoAnterior: EstadoDonacion
        - nuevoEstado: EstadoDonacion
        - usuarioResponsable: String
        - justificacion: String
    }

    class ConfiguracionMatchmaking {
        - id: Long
        - a1: double
        - a2: double
        - a3: double
        - alpha: double
        - fechaActualizacion: LocalDateTime
    }

    class OutboxEvent {
        - id: Long
        - aggregateType: String
        - aggregateId: String
        - eventType: String
        - routingKey: String
        - payload: String
        - status: OutboxStatus
        - createdAt: LocalDateTime
        - publishedAt: LocalDateTime
        - retries: int
    }

    interface MatchmakingStrategy <<Strategy>> {
        + ordenarCandidatos(donacion: Donacion, necesidades: List<NecesidadMaterial>): List<MatchmakingResult>
    }

    class CompatibilidadSemanticaStrategy {
        - a1: double
        - a2: double
        - a3: double
    }

    class PrioridadSubatendidosStrategy {
        - alpha: double
    }

    PersonaDonante <|-- PersonaHumana
    PersonaDonante <|-- PersonaJuridica
    PersonaDonante "1" *-- "1..*" MedioContacto
    PersonaDonante "1" o-- "0..*" Donacion : efectúa

    EntidadBeneficiaria "1" *-- "0..*" NecesidadMaterial
    EntidadBeneficiaria "0..1" o-- "0..*" Donacion : recibe
    NecesidadMaterial "0..1" o-- "0..*" Donacion : cubre

    Donacion "1" *-- "1..*" BienDonado : contiene
    Donacion "1" *-- "1..*" HistorialEstadoDonacion : audita
    Donacion --> EstadoDonacion

    MatchmakingStrategy <|.. CompatibilidadSemanticaStrategy
    MatchmakingStrategy <|.. PrioridadSubatendidosStrategy
}

' ========================================================
' SERVICIO DE LOGÍSTICA (MongoDB NoSQL)
' ========================================================
package "logistica-service (MongoDB)" #E6FFFA {

    class Camion <<Document>> {
        - id: String
        - patente: String
        - marcaModelo: String
        - capacidadVolumenM3: double
        - alturaM: double
        - capacidadPesoKg: double
        - activo: boolean
        - ubicacionActual: CoordenadaGPS
        + actualizarUbicacion(lat: double, lon: double, vel: double, ts: LocalDateTime, dir: String): boolean
    }

    class CoordenadaGPS <<ValueObject>> {
        - latitud: double
        - longitud: double
        - velocidadKmH: double
        - timestamp: LocalDateTime
        - direccionAproximada: String
    }

    class Ruta <<Document>> {
        - id: String
        - loteId: String
        - idCamion: String
        - patenteCamion: String
        - fechaPlanificada: LocalDate
        - estado: EstadoRuta
        - distanciaKmTotal: Double
        - tiempoEstimadoMinutos: Integer
        - paradas: List<Parada>
        + iniciarRuta(): void
        + finalizarRuta(): void
        + completarParada(orden: int): void
    }

    class Parada <<Embedded>> {
        - orden: int
        - tipo: TipoParada
        - idEntidadBeneficiaria: Long
        - nombreEntidad: String
        - direccion: String
        - latitud: double
        - longitud: double
        - idDonacion: Long
        - completada: boolean
    }

    class Entrega <<Document>> {
        - id: String
        - idRuta: String
        - idDonacion: Long
        - idEntidadBeneficiaria: Long
        - idDonante: Long
        - emailDonante: String
        - canalPreferidoDonante: String
        - contactoPreferidoDonante: String
        - patenteCamion: String
        - estado: EstadoEntrega
        - receptorNombre: String
        - receptorDni: String
        - firmaDigitalUrl: String
        - fotosConfirmacionUrls: List<String>
        - motivoFalla: String
        - replanificable: boolean
    }

    class DonacionPendienteLote <<Document>> {
        - id: String
        - loteId: String
        - idDonacion: Long
        - motivoNoAsignacion: String
        - procesado: boolean
    }

    Camion "1" *-- "0..1" CoordenadaGPS
    Ruta "1" *-- "1..*" Parada
    Ruta "1" ..> "1..*" Entrega
}

' ========================================================
' SERVICIO DE INCENTIVOS (PostgreSQL)
' ========================================================
package "incentivos-service (PostgreSQL)" #FFF9E6 {

    class PerfilDonanteIncentivo {
        - id: Long
        - idDonante: Long
        - nombre: String
        - email: String
        - canalPreferido: String
        - contactoPreferido: String
        - categoria: CategoriaDonante
        - totalDonaciones: int
        - totalBienesDonados: double
        - organizacionesAyudadas: int
        - rachaMesesConsecutivos: int
        - ultimaDonacionFecha: LocalDate
        - subcategoriasDonadas: Set<String>
        - organizacionesAyudadasIds: Set<Long>
        + ascenderCategoria(): void
        + actualizarRachaMensual(fecha: LocalDate): void
    }

    class Mision {
        - id: Long
        - nombre: String
        - descripcion: String
        - tipo: TipoMision
        - categoriaRequerida: CategoriaDonante
        - objetivo: double
        - ordenSecuencia: int
        - nombreInsignia: String
    }

    class ProgresoMision {
        - id: Long
        - idDonante: Long
        - mision: Mision
        - progresoActual: double
        - completada: boolean
        - fechaCompletada: LocalDateTime
        + agregarProgreso(delta: double): void
    }

    class Insignia {
        - id: Long
        - nombre: String
        - descripcion: String
        - imagenUrl: String
        - fechaObtencion: LocalDateTime
        - esPublica: boolean
    }

    class RankingMensual {
        - id: Long
        - anio: int
        - mes: int
        - posicion: int
        - idDonante: Long
        - nombreDonante: String
        - misionesCompletadasMes: int
    }

    PerfilDonanteIncentivo --> CategoriaDonante
    PerfilDonanteIncentivo "1" *-- "0..*" Insignia
    ProgresoMision --> Mision
}

' ========================================================
' SERVICIO DE NOTIFICACIONES (PostgreSQL)
' ========================================================
package "notificaciones-service (PostgreSQL)" #F9EBEA {

    class AuditoriaNotificacion {
        - id: Long
        - claveEvento: String
        - destinatario: String
        - canal: CanalNotificacion
        - asunto: String
        - mensaje: String
        - estado: EstadoNotificacion
        - intentos: int
        - timestamp: LocalDateTime
    }

    class RegistroEventoNotificacion {
        - id: Long
        - claveEvento: String
        - tipoEvento: String
        - fechaProcesado: LocalDateTime
    }
}

@enduml
