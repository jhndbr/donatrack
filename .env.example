# ==============================================================================
# DONATRACK - VARIABLES DE ENTORNO PARA DESPLIEGUE (DOCKER / PRODUCCIÓN)
# ==============================================================================

# --- INFRAESTRUCTURA DE BASE DE DATOS Y MENSAJERÍA ---
SPRING_DATASOURCE_USERNAME=donatrack
SPRING_DATASOURCE_PASSWORD=donatrack_password
SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=donatrack
SPRING_RABBITMQ_PASSWORD=donatrack_password

# --- CONFIGURACIÓN DE NOTIFICACIONES-SERVICE (:8085) ---
# En desarrollo local se utiliza Mailpit (puerto SMTP 1025, interfaz web 8025).
# En despliegue productivo (Gmail, SendGrid, Amazon SES, Mailgun, etc.),
# completar con el host SMTP real y credenciales de autenticación.
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=1025
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROTOCOL=smtp
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=false
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=false
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_REQUIRED=false

# Datos corporativos de remitente y correo de administración para alertas críticas
DONATRACK_ADMIN_EMAIL=admin@donatrack.org
DONATRACK_MAIL_FROM=notificaciones@donatrack.org
DONATRACK_MAIL_FROM_NAME=DonaTrack Solidaria
DONATRACK_FRONTEND_URL=http://localhost:8086

# --- CANAL SMS (TWILIO ADAPTER) ---
# Si se omiten las credenciales, el microservicio opera en modo SIMULADO
# registrando el despacho en la base de datos de auditoría sin error.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+15005550006

# --- CANAL WHATSAPP (META GRAPH / CLOUD API) ---
# Si se omiten las credenciales, el microservicio opera en modo SIMULADO
# registrando el despacho en la base de datos de auditoría sin error.
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- EXCHANGES Y COLAS RABBITMQ ---
DONATRACK_RABBITMQ_EXCHANGE=donatrack.events.exchange
DONATRACK_QUEUE_DONACION_REGISTRADA=q.notificaciones.donacion-registrada
DONATRACK_QUEUE_DONACION_ASIGNADA=q.notificaciones.donacion-asignada
DONATRACK_QUEUE_DONANTE_INACTIVO=q.notificaciones.donante-inactivo
DONATRACK_QUEUE_DONANTE_REGISTRADO=q.notificaciones.donante-registrado
DONATRACK_QUEUE_RUTA_INICIADA=q.notificaciones.ruta-iniciada
DONATRACK_QUEUE_ENTREGA_CONFIRMADA=q.notificaciones.entrega-confirmada
DONATRACK_QUEUE_ENTREGA_FALLIDA=q.notificaciones.entrega-fallida
DONATRACK_QUEUE_MISION_CUMPLIDA=q.notificaciones.mision-cumplida
DONATRACK_QUEUE_CATEGORIA_ASCENDIDA=q.notificaciones.categoria-ascendida
